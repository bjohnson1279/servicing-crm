# ==============================================================================
# Servicing CRM — Environment Configuration Template
# ==============================================================================

# --- Active Compose Profile ---
# Options:
#   default   - Boots Postgres + Redis + Express API + 3 Frontend Apps
#   all       - Boots all 4 Backends (Express, Laravel, GraphQL, FastAPI) + Apps
#   express   - Boots Postgres + Redis + Express API
#   laravel   - Boots Postgres + Redis + Laravel API
#   graphql   - Boots Postgres + Redis + GraphQL API
#   fastapi   - Boots Postgres + Redis + FastAPI API
#   apps      - Boots 3 Frontend Portals (Admin, Customer, Tech)
COMPOSE_PROFILES=default

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
POSTGRES_PORT=3110

# --- Redis Credentials (Redis 7) ---
REDIS_PASSWORD=redis_password
REDIS_PORT=3120

# --- Backend Host Port Bindings ---
EXPRESS_API_PORT=3182
LARAVEL_API_PORT=3181
GRAPHQL_API_PORT=3183
FASTAPI_API_PORT=3184

# --- Frontend Portal Host Port Bindings ---
ADMIN_PORTAL_PORT=3100
CUSTOMER_PORTAL_PORT=3101
TECH_PORTAL_PORT=3002

# --- Application Runtime Environments ---
NODE_ENV=development
APP_ENV=development
APP_DEBUG=true
FASTAPI_ENV=development
