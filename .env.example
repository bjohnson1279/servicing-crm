# ==============================================================================
# Servicing CRM — Environment Configuration Template
# ==============================================================================

# --- Active Compose Profile ---
# Options:
#   default   - Boots Postgres + Redis + Express API + 3 Frontend Apps
#   all       - Boots all 4 Backends (Express, Laravel, GraphQL, FastAPI) + Apps
#   express   - Boots Postgres + Redis + Express API
#   laravel   - Boots Postgres + Redis + Laravel API
#   graphql   - Boots Postgres + Redis + GraphQL API
#   fastapi   - Boots Postgres + Redis + FastAPI API
#   apps      - Boots Express API + 3 Frontend Portals
COMPOSE_PROFILES=default

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=<your-db-name>
POSTGRES_PORT=3110

# --- Redis Credentials (Redis 7) ---
REDIS_PASSWORD=<your-redis-password>
REDIS_PORT=3120

# --- Backend Host Port Bindings ---
EXPRESS_API_PORT=3182
LARAVEL_API_PORT=3181
GRAPHQL_API_PORT=3183
FASTAPI_API_PORT=3184

# --- Frontend Portal Host Port Bindings ---
ADMIN_PORTAL_PORT=3102
CUSTOMER_PORTAL_PORT=3101
TECH_PORTAL_PORT=3002

# --- Application Runtime Environments ---
NODE_ENV=development
APP_ENV=development
APP_DEBUG=true
FASTAPI_ENV=development

# Shared HS256 signing key. Generate a random secret.
JWT_SECRET=<your-random-signing-secret>

# Laravel encryption key: base64-encoded 32 random bytes, prefixed with base64:
LARAVEL_APP_KEY=<your-laravel-encryption-key>

# Only one backend should run shared database workers when using the all profile.
EXPRESS_BACKGROUND_JOBS=true
GRAPHQL_BACKGROUND_JOBS=false
FASTAPI_BACKGROUND_JOBS=false
